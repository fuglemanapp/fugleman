DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Optional server-side monitoring. Use the DSN from the WhatSpent Sentry project.
SENTRY_DSN=""

# Personal WhatSpent assistant. Get a server-side key from Groq and never expose it to the browser.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Created automatically when a private Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=""

# WhatsApp Business through Zernio. Keep all values server-side.
ZERNIO_API_KEY=""
# Optional: restrict the webhook to one Zernio WhatsApp account ID.
ZERNIO_WHATSAPP_ACCOUNT_ID=""
ZERNIO_WEBHOOK_SECRET=""
